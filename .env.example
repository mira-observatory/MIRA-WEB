# Copia a .env.local. Todo lo que empieza con VITE_ queda expuesto en el paquete
# que se envia al navegador, asi que aqui NUNCA va un secreto.
#
# El prototipo anterior incrustaba la clave de Supabase en el codigo. Este
# repositorio no habla con la base de datos: toda consulta pasa por MIRA-API.

VITE_MIRA_API_BASE_URL=http://localhost:8000

# Para Docker Compose, copiar esta misma plantilla a .env.digitalocean.
# Reemplazar la URL anterior por la API publica ANTES de construir la imagen.
# Estos valores no tienen el prefijo VITE_: solo los utiliza Docker Compose.
MIRA_IMAGE_TAG=local
MIRA_HTTP_PORT=80
